<% layout("/layouts/boilerplate") %>

<div class="container my-5 animate__animated animate__fadeIn">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-light">
        <h2 class="fw-bold text-primary"><i class="fas fa-heart me-2 text-danger"></i>My Wishlist</h2>
        <span class="badge bg-secondary rounded-pill px-3 py-2 fs-6">
            <%= savedListings.length %> Saved Room<%= savedListings.length !== 1 ? 's' : '' %>
        </span>
    </div>

    <% if (savedListings.length === 0) { %>
        <div class="text-center py-5 bg-light rounded-4 border shadow-sm my-4">
            <div class="mb-4">
                <i class="far fa-heart fa-4x text-muted animate__animated animate__pulse animate__infinite"></i>
            </div>
            <h4 class="fw-bold text-dark">Your Wishlist is Empty</h4>
            <p class="text-muted mb-4">Explore our listings and click the heart icon on any accommodation to save it here.</p>
            <a href="/listings" class="btn btn-primary rounded-pill px-4 py-2">
                <i class="fas fa-search me-2"></i>Explore Accommodations
            </a>
        </div>
    <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% savedListings.forEach((listing, index) => { %>
                <div class="col listing-item" style="animation-delay: calc(<%= index %> * 0.1s);">
                    <div class="card h-100 shadow-sm border listing-card position-relative">
                        
                        <!-- Floating Heart to Toggle / Remove -->
                        <button class="btn btn-link position-absolute top-0 start-0 m-3 p-0 bg-white bg-opacity-75 rounded-circle shadow-sm d-flex align-items-center justify-content-center wishlist-btn" 
                                type="button" 
                                data-id="<%= listing._id %>" 
                                style="z-index: 10; width: 36px; height: 36px;"
                                title="Remove from Wishlist">
                            <i class="fas fa-heart text-danger" style="font-size: 1.1rem; transition: transform 0.2s ease;"></i>
                        </button>

                        <a href="/listings/<%= listing._id %>" class="text-decoration-none card-link text-dark h-100 d-flex flex-column">
                            <div class="card-img-top-container">
                                <img src="<%= (listing.images && listing.images.length > 0) ? listing.images[0] : '/images/default.jpeg' %>" 
                                     class="card-img-top" 
                                     alt="<%= listing.title %>"
                                     onerror="this.src='https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800&h=350&fit=crop'">
                            </div>

                            <div class="card-body d-flex flex-column p-4">
                                <div class="mb-2">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <small class="text-muted">Room Title</small>
                                        <% if(listing.owner && listing.owner.isVerifiedOwner) { %>
                                            <span class="badge bg-success rounded-pill py-0.5 px-2 text-white" style="font-size: 0.7rem;">
                                                <i class="fas fa-check-circle me-1"></i>Verified
                                            </span>
                                        <% } %>
                                    </div>
                                    <h5 class="card-title fw-bold text-dark text-truncate mb-0 mt-1"><%= listing.title %></h5>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted"><i class="fas fa-map-marker-alt me-1"></i>Location</small>
                                    <p class="card-text text-muted text-truncate mb-0"><%= listing.location %>, <%= listing.city %></p>
                                </div>

                                <div class="mt-auto pt-3 border-top border-light d-flex justify-content-between align-items-center">
                                    <div class="price-tag">
                                        <small class="text-muted d-block">Monthly Rent</small>
                                        <span class="fw-bold fs-5 text-success">₹<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></span>
                                        <small class="text-muted">/mo</small>
                                    </div>
                                    <span class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                        View Details <i class="fas fa-arrow-right ms-1"></i>
                                    </span>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>
