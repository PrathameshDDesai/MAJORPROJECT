<% layout("/layouts/boilerplate") %>

    <div class="signup-container">
        <div class="signup-card">
            <div class="signup-header">
                <div class="icon-circle">
                    <i class="fas fa-user-plus"></i>
                </div>
                <h2>Create Account</h2>
                <p>Join UniRooms to find your perfect room</p>
            </div>

            <form action="/signup" method="POST" class="signup-form needs-validation" novalidate>
                <!-- Full Name -->
                <div class="form-group">
                    <label for="fullname">
                        <i class="fas fa-id-card"></i> Full Name
                    </label>
                    <input type="text" id="fullname" name="fullname" class="form-input"
                        placeholder="Enter your full name" required>
                    <div class="invalid-feedback">Please provide your full name.</div>
                </div>

                <!-- Username -->
                <div class="form-group">
                    <label for="username">
                        <i class="fas fa-user"></i> Username
                    </label>
                    <input type="text" id="username" name="username" class="form-input" placeholder="Choose a username"
                        required>
                    <div class="invalid-feedback">Please choose a username.</div>
                </div>

                <!-- Email -->
                <div class="form-group">
                    <label for="email">
                        <i class="fas fa-envelope"></i> Email Address
                    </label>
                    <input type="email" id="email" name="email" class="form-input" placeholder="your.email@example.com"
                        required>
                    <div class="invalid-feedback">Please provide a valid email.</div>
                </div>

                <!-- Role Selection -->
                <div class="form-group">
                    <label class="role-label">
                        <i class="fas fa-users"></i> Register as:
                    </label>
                    <div class="role-selector">
                        <div class="role-option active" data-role="Student">
                            <input type="radio" id="roleStudent" name="role" value="Student" checked>
                            <label for="roleStudent">
                                <i class="fas fa-graduation-cap"></i>
                                <span>Student</span>
                            </label>
                        </div>
                        <div class="role-option" data-role="Owner">
                            <input type="radio" id="roleOwner" name="role" value="Owner">
                            <label for="roleOwner">
                                <i class="fas fa-house-user"></i>
                                <span>Property Owner</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Owner Specific Details (Hidden by default) -->
                <div id="owner-details" class="d-none">
                    <div class="form-group">
                        <label for="phoneNumber">
                            <i class="fas fa-phone"></i> Phone Number
                        </label>
                        <input type="tel" id="phoneNumber" name="phoneNumber" class="form-input"
                            placeholder="Enter your contact number">
                        <div class="invalid-feedback">Please provide your phone number.</div>
                    </div>

                    <div class="form-group">
                        <label for="address">
                            <i class="fas fa-map-marker-alt"></i> Address
                        </label>
                        <textarea id="address" name="address" class="form-input" placeholder="Enter your full address"
                            rows="2"></textarea>
                        <div class="invalid-feedback">Please provide your address.</div>
                    </div>
                </div>

                <!-- Password -->
                <div class="form-group">
                    <label for="password">
                        <i class="fas fa-lock"></i> Password
                    </label>
                    <div class="password-input-wrapper">
                        <input type="password" id="password" name="password" class="form-input"
                            placeholder="Create a strong password" required>
                        <button type="button" class="password-toggle" id="togglePassword">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="invalid-feedback">Please provide a password.</div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-submit">
                    Create Account <i class="fas fa-arrow-right"></i>
                </button>

                <!-- Login Link -->
                <div class="form-footer">
                    Already have an account? <a href="/login" class="link-primary">Log In</a>
                </div>
            </form>
        </div>
    </div>

    <link rel="stylesheet" href="/css/signup.css">
    <script src="/js/signup.js"></script>