<% layout("/layouts/boilerplate") %>

    <div class="row mt-3">
        <div class="col-12 col-lg-10 mx-auto">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white py-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-circle bg-white bg-opacity-25 me-3">
                            <i class="fas fa-edit"></i>
                        </div>
                        <div>
                            <h4 class="mb-0 fw-bold">Edit Room Listing</h4>
                            <small class="opacity-100">Update your listing information</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form action="/listings/<%= listing._id %>?_method=PATCH" method="POST"
                        enctype="multipart/form-data" class="needs-validation" novalidate>

                        <!-- Basic Information Section -->
                        <div class="form-section mb-4">
                            <div class="section-header mb-3">
                                <h5 class="text-primary mb-0">
                                    <i class="fas fa-info-circle me-2"></i>Basic Information
                                </h5>
                                <hr class="mt-2">
                            </div>

                            <!-- Title -->
                            <div class="mb-3">
                                <label for="title" class="form-label fw-semibold">
                                    <i class="fas fa-heading me-1 text-muted"></i>
                                    Title <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="title" name="listing[title]" value="<%= listing.title %>"
                                    class="form-control form-control-lg"
                                    placeholder="e.g., Cozy Single Room Near Campus" required>
                                <div class="invalid-feedback">
                                    Please provide a title for the listing.
                                </div>
                            </div>

                            <!-- Description -->
                            <div class="mb-3">
                                <label for="description" class="form-label fw-semibold">
                                    <i class="fas fa-align-left me-1 text-muted"></i>
                                    Description <span class="text-danger">*</span>
                                </label>
                                <textarea id="description" name="listing[description]" class="form-control" rows="5"
                                    placeholder="Describe the room, amenities, house rules, nearby facilities..."
                                    required><%= listing.description %></textarea>
                                <div class="form-text">
                                    <i class="fas fa-lightbulb me-1"></i>
                                    Include details about amenities, location benefits, and any special features
                                </div>
                                <div class="invalid-feedback">
                                    Please provide a description.
                                </div>
                            </div>
                        </div>

                        <!-- Pricing & Location Section -->
                        <div class="form-section mb-4">
                            <div class="section-header mb-3">
                                <h5 class="text-primary mb-0">
                                    <i class="fas fa-map-marked-alt me-2"></i>Pricing & Location
                                </h5>
                                <hr class="mt-2">
                            </div>

                            <div class="row">
                                <!-- Price -->
                                <div class="col-md-6 mb-3">
                                    <label for="price" class="form-label fw-semibold">
                                        <i class="fas fa-rupee-sign me-1 text-muted"></i>
                                        Monthly Rent <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-rupee-sign text-success"></i>
                                        </span>
                                        <input type="number" id="price" name="listing[price]"
                                            value="<%= listing.price %>" class="form-control" placeholder="5000" min="1"
                                            required>
                                        <span class="input-group-text bg-light text-muted">/month</span>
                                    </div>
                                    <div class="invalid-feedback">
                                        Please provide a valid price.
                                    </div>
                                </div>

                                <!-- Location -->
                                <div class="col-md-6 mb-3">
                                    <label for="location" class="form-label fw-semibold">
                                        <i class="fas fa-map-marker-alt me-1 text-muted"></i>
                                        Location <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" id="location" name="listing[location]"
                                        class="form-control form-control-lg" placeholder="e.g., Koregaon Park"
                                        value="<%= listing.location %>" required>
                                    <div class="invalid-feedback">
                                        Please provide a location.
                                    </div>
                                </div>

                                <!-- City -->
                                <div class="col-md-6 mb-3">
                                    <label for="city" class="form-label fw-semibold">
                                        <i class="fas fa-city me-1 text-muted"></i>
                                        City <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" id="city" name="listing[city]"
                                        class="form-control form-control-lg" placeholder="e.g., Pune"
                                        value="<%= listing.city || '' %>" required>
                                    <div class="invalid-feedback">
                                        Please provide a city.
                                    </div>
                                </div>

                                <!-- Gender -->
                                <div class="col-md-6 mb-3">
                                    <label for="gender" class="form-label fw-semibold">
                                        <i class="fas fa-venus-mars me-1 text-muted"></i>
                                        Gender Preference <span class="text-danger">*</span>
                                    </label>
                                    <select id="gender" name="listing[gender]" class="form-select form-select-lg"
                                        required>
                                        <option value="Boys" <%=listing.gender==='Boys' ? 'selected' : '' %>>Boys
                                        </option>
                                        <option value="Girls" <%=listing.gender==='Girls' ? 'selected' : '' %>>Girls
                                        </option>
                                        <option value="Any" <%=listing.gender==='Any' || !listing.gender ? 'selected'
                                            : '' %>>Any</option>
                                    </select>
                                    <div class="invalid-feedback">
                                        Please select a gender preference.
                                    </div>
                                </div>

                                <!-- Interactive Map Selector -->
                                <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
                                <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

                                <div class="col-md-12 mb-4">
                                    <label class="form-label fw-semibold text-success">
                                        <i class="fas fa-map-marked-alt me-1"></i>
                                        Pin Exact Location on Map <span class="text-danger">*</span>
                                    </label>
                                    
                                    <div class="input-group mb-2 shadow-sm rounded-3 overflow-hidden">
                                        <input type="text" id="mapSearchInput" class="form-control border-light" placeholder="Search address to pin on map...">
                                        <button class="btn btn-primary" type="button" id="mapSearchBtn">
                                            <i class="fas fa-search me-1"></i>Find Address
                                        </button>
                                    </div>
                                    
                                    <div id="map" style="height: 320px; width: 100%; border-radius: 12px; z-index: 1;" class="border shadow-sm mb-3"></div>
                                    
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <label for="longitude" class="form-label small text-secondary fw-semibold">Longitude</label>
                                            <input type="number" step="any" id="longitude" name="listing[coordinates][]" class="form-control form-control-sm border-2 rounded-3 bg-light" value="<%= (listing.coordinates && listing.coordinates.length === 2) ? listing.coordinates[0] : 72.8777 %>" required readonly>
                                        </div>
                                        <div class="col-6">
                                            <label for="latitude" class="form-label small text-secondary fw-semibold">Latitude</label>
                                            <input type="number" step="any" id="latitude" name="listing[coordinates][]" class="form-control form-control-sm border-2 rounded-3 bg-light" value="<%= (listing.coordinates && listing.coordinates.length === 2) ? listing.coordinates[1] : 19.0760 %>" required readonly>
                                        </div>
                                    </div>
                                </div>

                                <script>
                                    document.addEventListener("DOMContentLoaded", () => {
                                        // Load existing coords or default to Mumbai
                                        const lat = parseFloat("<%= (listing.coordinates && listing.coordinates.length === 2) ? listing.coordinates[1] : 19.0760 %>");
                                        const lng = parseFloat("<%= (listing.coordinates && listing.coordinates.length === 2) ? listing.coordinates[0] : 72.8777 %>");
                                        const initialCoords = [lat, lng];
                                        
                                        const map = L.map('map').setView(initialCoords, 14);
                                        
                                        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                                            attribution: '&copy; OpenStreetMap contributors'
                                        }).addTo(map);
                                        
                                        let marker = L.marker(initialCoords, { draggable: true }).addTo(map);
                                        
                                        function updateInputs(lat, lng) {
                                            document.getElementById('latitude').value = lat;
                                            document.getElementById('longitude').value = lng;
                                        }
                                        
                                        marker.on('dragend', function (e) {
                                            const position = marker.getLatLng();
                                            updateInputs(position.lat, position.lng);
                                        });
                                        
                                        map.on('click', function (e) {
                                            marker.setLatLng(e.latlng);
                                            updateInputs(e.latlng.lat, e.latlng.lng);
                                        });
                                        
                                        const searchBtn = document.getElementById('mapSearchBtn');
                                        const searchInput = document.getElementById('mapSearchInput');
                                        
                                        if (searchBtn && searchInput) {
                                            searchBtn.addEventListener('click', () => {
                                                const query = searchInput.value.trim();
                                                if (!query) return;
                                                
                                                fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}`)
                                                    .then(res => res.json())
                                                    .then(data => {
                                                        if (data && data.length > 0) {
                                                            const result = data[0];
                                                            const nLat = parseFloat(result.lat);
                                                            const nLon = parseFloat(result.lon);
                                                            const newLatLng = new L.LatLng(nLat, nLon);
                                                            
                                                            map.setView(newLatLng, 15);
                                                            marker.setLatLng(newLatLng);
                                                            updateInputs(nLat, nLon);
                                                        } else {
                                                            alert('Location not found. Try searching or dragging the pin.');
                                                        }
                                                    })
                                                    .catch(err => console.error('Nominatim error:', err));
                                            });
                                        }
                                    });
                                </script>
                            </div>

                            <!-- Contact -->
                            <div class="mb-3">
                                <label for="contact" class="form-label fw-semibold">
                                    <i class="fas fa-phone me-1 text-muted"></i>
                                    Contact Information <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="contact" name="listing[contact]" value="<%= listing.contact %>"
                                    class="form-control form-control-lg" placeholder="Phone number or email" required>
                                <div class="form-text">
                                    <i class="fas fa-shield-alt me-1"></i>
                                    Your contact info will be visible to interested students
                                </div>
                                <div class="invalid-feedback">
                                    Please provide contact information.
                                </div>
                            </div>
                        </div>

                        <!-- Image Section -->
                        <div class="form-section mb-4">
                            <div class="section-header mb-3">
                                <h5 class="text-primary mb-0">
                                    <i class="fas fa-images me-2"></i>Manage Room Images
                                </h5>
                                <hr class="mt-2">
                            </div>

                            <!-- Current Images Management -->
                            <% if(listing.images && listing.images.length> 0) { %>
                                <div class="mb-4">
                                    <label class="form-label fw-semibold d-block mb-3">
                                        <i class="fas fa-th me-1 text-muted"></i>Current Images (Check to Delete)
                                    </label>
                                    <div class="row row-cols-2 row-cols-md-4 g-3">
                                        <% listing.images.forEach((img, idx)=> { %>
                                            <div class="col">
                                                <div class="card h-100 shadow-sm border-0 bg-light">
                                                    <div class="position-relative">
                                                        <img src="<%= img %>" class="card-img-top rounded-top"
                                                            alt="Room" style="height: 120px; object-fit: cover;">
                                                        <div class="position-absolute top-0 end-0 p-2">
                                                            <div class="form-check m-0">
                                                                <input
                                                                    class="form-check-input bg-danger border-danger shadow-none"
                                                                    type="checkbox" name="deleteImages"
                                                                    value="<%= img %>" id="img-<%= idx %>"
                                                                    style="width: 1.5em; height: 1.5em;">
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="card-footer p-2 text-center bg-transparent border-0">
                                                        <label class="form-check-label text-danger fw-bold small"
                                                            for="img-<%= idx %>">
                                                            <i class="fas fa-trash-alt me-1"></i>Delete
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }) %>
                                    </div>
                                </div>
                                <% } %>

                                    <!-- Add New Images via Local Storage -->
                                    <div class="mb-4" id="file-inputs-container">
                                        <label class="form-label fw-semibold">
                                            <i class="fas fa-desktop me-1 text-muted"></i>
                                            Add New Images (Upload)
                                        </label>
                                        <div class="input-group mb-2 file-input-group">
                                            <input type="file" name="imageFiles" class="form-control" accept="image/*">
                                            <button type="button" class="btn btn-outline-primary add-file-field">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Image Preview Area for New Uploads -->
                                    <div id="image-preview-container" class="row row-cols-4 g-2 mb-3"></div>

                                    <script>
                                        // Dynamic File fields
                                        document.querySelector('.add-file-field').addEventListener('click', function () {
                                            const container = document.getElementById('file-inputs-container');
                                            const currentFields = container.querySelectorAll('.file-input-group').length;
                                            const currentImages = document.querySelectorAll('.card-img-top').length;

                                            if (currentFields + currentImages < 10) {
                                                const div = document.createElement('div');
                                                div.className = 'input-group mb-2 file-input-group';
                                                div.innerHTML = `
                                                    <input type="file" name="imageFiles" class="form-control" accept="image/*">
                                                    <button type="button" class="btn btn-outline-danger remove-file-field">
                                                        <i class="fas fa-minus"></i>
                                                    </button>
                                                `;
                                                container.appendChild(div);

                                                div.querySelector('.remove-file-field').addEventListener('click', function () {
                                                    div.remove();
                                                    updatePreviews();
                                                });
                                                div.querySelector('input').addEventListener('change', updatePreviews);
                                            } else {
                                                alert("Maximum 10 total images allowed");
                                            }
                                        });

                                        // Preview logic
                                        function updatePreviews() {
                                            const previewContainer = document.getElementById('image-preview-container');
                                            previewContainer.innerHTML = '';
                                            const files = document.querySelectorAll('input[name="imageFiles"]');

                                            files.forEach(input => {
                                                if (input.files && input.files[0]) {
                                                    const reader = new FileReader();
                                                    reader.onload = function (e) {
                                                        const col = document.createElement('div');
                                                        col.className = 'col';
                                                        col.innerHTML = `
                                                            <div class="card h-100 shadow-sm border-0">
                                                                <img src="${e.target.result}" class="card-img-top rounded shadow-sm" style="height: 80px; object-fit: cover;">
                                                                <div class="card-footer p-1 text-center bg-light border-0">
                                                                    <small class="text-primary fw-bold" style="font-size: 0.7rem;">New</small>
                                                                </div>
                                                            </div>
                                                        `;
                                                        previewContainer.appendChild(col);
                                                    };
                                                    reader.readAsDataURL(input.files[0]);
                                                }
                                            });
                                        }
                                        document.querySelector('input[name="imageFiles"]').addEventListener('change', updatePreviews);
                                    </script>

                                    <div class="text-center my-3">
                                        <span class="badge bg-secondary px-3 py-2">
                                            <i class="fas fa-arrows-alt-h me-1"></i> OR
                                        </span>
                                    </div>

                                    <!-- Add New Images via URL -->
                                    <div class="mb-3" id="url-inputs-container">
                                        <label class="form-label fw-semibold">
                                            <i class="fas fa-link me-1 text-muted"></i>
                                            Add Image URLs
                                        </label>
                                        <div class="input-group mb-2 url-input-group">
                                            <input type="url" name="imageUrls" class="form-control"
                                                placeholder="https://example.com/image.jpg">
                                            <button type="button" class="btn btn-outline-primary add-url-field">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                        </div>
                                    </div>
                        </div>

                        <script>
                            // Handle Dynamic URL fields
                            document.querySelector('.add-url-field').addEventListener('click', function () {
                                const container = document.getElementById('url-inputs-container');
                                const currentFields = container.querySelectorAll('.url-input-group').length;
                                const currentImages = document.querySelectorAll('.card-img-top').length; // Images already there

                                if (currentFields + currentImages < 10) {
                                    const div = document.createElement('div');
                                    div.className = 'input-group mb-2 url-input-group';
                                    div.innerHTML = `
                                        <input type="url" name="imageUrls" class="form-control" placeholder="https://example.com/another-image.jpg">
                                        <button type="button" class="btn btn-outline-danger remove-url-field">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                    `;
                                    container.appendChild(div);

                                    div.querySelector('.remove-url-field').addEventListener('click', function () {
                                        div.remove();
                                    });
                                } else {
                                    alert("Maximum images reached");
                                }
                            });
                        </script>

                        <!-- Action Buttons -->
                        <div class="d-flex flex-column flex-md-row gap-3 mt-5 pt-3 border-top">
                            <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary btn-lg flex-fill">
                                <i class="fas fa-times me-2"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg flex-fill">
                                <i class="fas fa-save me-2"></i> Update Listing
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>