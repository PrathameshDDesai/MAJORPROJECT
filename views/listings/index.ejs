<% layout("/layouts/boilerplate") %>

    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-4 fw-bold text-dark mb-2" data-i18n="availableRoomsTitle">Available Rooms</h1>
            <p class="lead text-muted" data-i18n="availableRoomsSubtitle">Find your perfect university accommodation with ease.</p>
            <div class="mx-auto" style="width: 80px; height: 4px; background: var(--action); border-radius: 2px;"></div>
        </div>
    </div>

    <% if (allListings.length===0) { %>
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i>
                    No rooms available yet.
                    <a href="/listings/new" class="alert-link text-decoration-none">Add the first listing!</a>
                </div>
            </div>
        </div>
        <% } else { %>

            <div class="row mb-4">
                <div class="col-md-6 mb-2 mb-md-0">
                    <div class="input-group">
                        <span class="input-group-text bg-light">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control border-light"
                            placeholder="Search rooms..." data-i18n="searchPlaceholder">
                    </div>
                </div>
                <div class="col-md-3 mb-2 mb-md-0">
                    <select id="cityFilter" class="form-select border-light">
                        <option value="">All Cities</option>
                        <% const cities=[...new Set(allListings.map(l=> l.city).filter(c => c))];
                            cities.sort().forEach(city => { %>
                            <option value="<%= city %>">
                                <%= city %>
                            </option>
                            <% }); %>
                    </select>
                </div>
                <div class="col-md-2 mb-2 mb-md-0">
                    <select id="genderFilter" class="form-select border-light">
                        <option value="" data-i18n="allGenders">All Genders</option>
                        <option value="Boys" data-i18n="boysOnly">Boys</option>
                        <option value="Girls" data-i18n="girlsOnly">Girls</option>
                        <option value="Any" data-i18n="anyGender">Any</option>
                    </select>
                </div>
                <div class="col-md-2 text-md-end">
                    <span class="badge bg-secondary fs-6">
                        <i class="fas fa-bed me-1"></i>
                        <span id="listingCount">
                            <%= allListings.length %>
                        </span> Room<%= allListings.length !==1 ? 's' : '' %> Available
                    </span>
                </div>
            </div>

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="listingsContainer">
                <% allListings.forEach((listing, index)=> { %>
                    <div class="col listing-item" style="animation-delay: calc(<%= index %> * 0.1s);">
                        <a href="/listings/<%= listing._id %>" class="text-decoration-none card-link">
                            <div class="card h-100 shadow-sm border listing-card" data-city="<%= listing.city || '' %>"
                                data-gender="<%= listing.gender || 'Any' %>">
                                <div class="card-img-top-container position-relative">
                                    <img src="<%= (listing.images && listing.images.length > 0) ? listing.images[0] : '/images/default.jpeg' %>"
                                        class="card-img-top" alt="<%= listing.title %>" loading="lazy"
                                        onerror="this.src='https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800&h=350&fit=crop'">

                                    <!-- Wishlist Heart Button -->
                                    <button class="btn btn-link position-absolute top-0 start-0 m-2 p-0 bg-white bg-opacity-75 rounded-circle shadow-sm d-flex align-items-center justify-content-center wishlist-btn" 
                                            type="button" 
                                            data-id="<%= listing._id %>" 
                                            style="z-index: 10; width: 36px; height: 36px;"
                                            title="Save Room">
                                        <i class="<%= (currUser && currUser.savedListings && currUser.savedListings.includes(listing._id.toString())) ? 'fas fa-heart text-danger' : 'far fa-heart text-muted' %>" style="font-size: 1.1rem; transition: transform 0.2s ease;"></i>
                                    </button>

                                    <!-- Image Count Badge -->
                                    <% if(listing.images && listing.images.length> 1) { %>
                                        <div class="position-absolute top-0 end-0 m-2">
                                            <span class="badge bg-dark bg-opacity-75 shadow-sm">
                                                <i class="fas fa-images me-1 text-white"></i>
                                                <%= listing.images.length %>
                                            </span>
                                        </div>
                                    <% } %>
                                </div>

                                <div class="card-body d-flex flex-column">
                                    <div class="mb-2">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <small class="text-muted">Room Title</small>
                                            <% if(listing.owner && listing.owner.isVerifiedOwner) { %>
                                                <span class="badge bg-success rounded-pill py-0.5 px-2 text-white" style="font-size: 0.7rem;" title="Verified Owner">
                                                    <i class="fas fa-check-circle me-1"></i>Verified
                                                </span>
                                            <% } %>
                                        </div>
                                        <h5 class="card-title fw-bold text-dark text-truncate">
                                            <%= listing.title %>
                                        </h5>
                                    </div>

                                    <div class="mb-2">
                                        <small class="text-muted">
                                            <i class="fas fa-map-marker-alt me-1"></i>Location
                                        </small>
                                        <p class="card-text text-muted text-truncate">
                                            <%= listing.location %>
                                        </p>
                                    </div>

                                    <div class="mb-3 flex-grow-1">
                                        <small class="text-muted">Description</small>
                                        <p class="card-text text-secondary line-clamp-2">
                                            <%= listing.description.length> 100 ?
                                                listing.description.substring(0, 100) + '...' :
                                                listing.description %>
                                        </p>
                                    </div>

                                    <div class="mt-auto">
                                        <small class="text-muted">
                                            <i class="fas fa-tag me-1"></i>Monthly Rent
                                        </small>
                                        <div class="d-flex justify-content-between align-items-center mt-1">
                                            <h4 class="text-dark fw-bold mb-0">
                                                ₹<%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>
                                                    <small class="text-muted fs-6">/month</small>
                                            </h4>
                                            <span class="btn btn-outline-secondary btn-sm">
                                                View <i class="fas fa-arrow-right ms-1"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="card-footer bg-white border-top">
                                    <div class="d-flex justify-content-between text-muted small">
                                        <div>
                                            <i class="fas fa-user me-1"></i>
                                            <%= listing.contact || 'Contact not provided' %>
                                        </div>
                                        <div>
                                            <i class="fas fa-calendar me-1"></i>
                                            <%= new Date(listing.createdAt).toLocaleDateString() %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                    <% }) %>
            </div>

            <div id="noResults" class="row d-none">
                <div class="col-12">
                    <div class="alert alert-secondary text-center">
                        <i class="fas fa-search me-2"></i>
                        No rooms match your search.
                    </div>
                </div>
            </div>
            <% } %>

                <div class="row mt-5">
                    <div class="col-12 text-center">
                        <div class="card bg-light border py-4">
                            <div class="card-body">
                                <h4 class="card-title mb-3 text-dark">Have a room to rent?</h4>
                                <p class="card-text text-muted mb-4">List your room and connect with students.</p>
                                <a href="/listings/new" class="btn btn-secondary btn-lg">
                                    <i class="fas fa-plus-circle me-2"></i>Add New Listing
                                </a>
                            </div>
                        </div>
                    </div>
                </div>