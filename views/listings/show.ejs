<% layout("/layouts/boilerplate") %>

    <div class="card shadow-lg mx-auto show-page-card" style="max-width: 800px;">

        <!-- Image -->
        <img src="<%= listing.image %>" class="card-img-top show-page-image" alt="<%= listing.title %>"
            onerror="this.src='https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800&h=350&fit=crop'">

        <div class="card-body">
            <h3 class="card-title mb-2">
                <%= listing.title %>
            </h3>

            <!-- Average Rating Display -->
            <% if (listing.reviews && listing.reviews.length> 0) { %>
                <div class="mb-3">
                    <span class="badge bg-warning text-dark me-2">
                        <i class="fas fa-star"></i>
                        <%= listing.averageRating %>
                    </span>
                    <small class="text-muted">(<%= listing.reviews.length %>
                            <%= listing.reviews.length===1 ? 'review' : 'reviews' %>)</small>
                </div>
                <% } else { %>
                    <div class="mb-3">
                        <small class="text-muted">No reviews yet</small>
                    </div>
                    <% } %>

                        <p class="card-text text-muted mb-4">
                            <%= listing.description %>
                        </p>

                        <ul class="list-group list-group-flush my-3 show-page-list">
                            <li class="list-group-item">
                                <strong><i class="fas fa-rupee-sign me-2 text-success"></i>Price:</strong>
                                <span class="float-end fw-bold text-success">
                                    ₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / month
                                </span>
                            </li>

                            <li class="list-group-item">
                                <strong><i class="fas fa-map-marker-alt me-2 text-primary"></i>Location:</strong>
                                <span class="float-end">
                                    <%= listing.location %>
                                </span>
                            </li>

                            <li class="list-group-item">
                                <strong><i class="fas fa-phone me-2 text-info"></i>Contact:</strong>
                                <span class="float-end">
                                    <%= listing.contact %>
                                </span>
                            </li>
                        </ul>

                        <!-- Action Buttons -->
                        <div class="d-flex flex-column flex-md-row gap-2 mt-4">
                            <a href="/listings" class="btn btn-outline-secondary flex-fill">
                                <i class="fas fa-arrow-left me-1"></i> Back to Listings
                            </a>
                            <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning flex-fill">
                                <i class="fas fa-edit me-1"></i> Edit
                            </a>
                            <button type="button" class="btn btn-danger flex-fill" data-bs-toggle="modal"
                                data-bs-target="#deleteModal">
                                <i class="fas fa-trash me-1"></i> Delete
                            </button>
                        </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteModalLabel">
                        <i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>"<%= listing.title %>"</strong>?</p>
                    <p class="text-muted small mb-0">This action cannot be undone.</p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                        <button type="submit" class="btn btn-danger">Delete Listing</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Reviews Section -->
    <div class="card shadow-sm p-4 mt-5">

        <h4 class="mb-4">
            <i class="fas fa-comments me-2 text-primary"></i>Reviews
        </h4>

        <!-- Leave a Review -->
        <div class="card review-form-card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-star me-2"></i>Leave a Review
                </h5>
            </div>
            <div class="card-body">
                <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Rating</label>
                        <select class="form-select" name="review[rating]" required>
                            <option value="">Choose rating...</option>
                            <option value="5">⭐⭐⭐⭐⭐ Excellent</option>
                            <option value="4">⭐⭐⭐⭐ Very Good</option>
                            <option value="3">⭐⭐⭐ Good</option>
                            <option value="2">⭐⭐ Fair</option>
                            <option value="1">⭐ Poor</option>
                        </select>
                        <div class="invalid-feedback">Please select a rating.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Comment</label>
                        <textarea class="form-control" name="review[comment]" rows="4" required></textarea>
                        <div class="invalid-feedback">Please provide a comment.</div>
                    </div>

                    <button type="submit" class="btn btn-primary">Submit Review</button>
                </form>
            </div>
        </div>

        <!-- Display Reviews -->
        <% if (listing.reviews && listing.reviews.length> 0) { %>
            <div class="reviews-grid">
                <% listing.reviews.forEach(review=> { %>
                    <div class="card review-card mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="flex-grow-1">
                                    <div class="mb-2">
                                        <% for (let i=1; i <=5; i++) { %>
                                            <% if (i <=review.rating) { %>
                                                <i class="fas fa-star text-warning"></i>
                                                <% } else { %>
                                                    <i class="far fa-star text-muted"></i>
                                                    <% } %>
                                                        <% } %>
                                                            <span class="ms-2 text-muted">(<%= review.rating %>
                                                                    /5)</span>
                                    </div>

                                    <p class="mb-2">
                                        <%= review.comment %>
                                    </p>

                                    <small class="text-muted">
                                        <i class="far fa-clock me-1"></i>
                                        <%= new Date(review.createdAt).toLocaleDateString('en-IN', { year: 'numeric' ,
                                            month: 'long' , day: 'numeric' }) %>
                                    </small>
                                </div>

                                <div class="ms-3">
                                    <button class="btn btn-sm btn-outline-primary me-1" data-bs-toggle="modal"
                                        data-bs-target="#editReviewModal-<%= review._id %>">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal"
                                        data-bs-target="#deleteReviewModal-<%= review._id %>">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Edit Review Modal -->
                    <div class="modal fade" id="editReviewModal-<%= review._id %>" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header bg-primary text-white">
                                    <h5 class="modal-title"><i class="fas fa-edit me-2"></i>Edit Review</h5>
                                    <button type="button" class="btn-close btn-close-white"
                                        data-bs-dismiss="modal"></button>
                                </div>
                                <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=PATCH"
                                    method="POST">
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">Rating</label>
                                            <select class="form-select" name="review[rating]" required>
                                                <option value="5" <%=review.rating===5 ? 'selected' : '' %>>⭐⭐⭐⭐⭐
                                                    Excellent</option>
                                                <option value="4" <%=review.rating===4 ? 'selected' : '' %>>⭐⭐⭐⭐
                                                    Very
                                                    Good</option>
                                                <option value="3" <%=review.rating===3 ? 'selected' : '' %>>⭐⭐⭐ Good
                                                </option>
                                                <option value="2" <%=review.rating===2 ? 'selected' : '' %>>⭐⭐ Fair
                                                </option>
                                                <option value="1" <%=review.rating===1 ? 'selected' : '' %>>⭐ Poor
                                                </option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">Comment</label>
                                            <textarea class="form-control" name="review[comment]" rows="4"
                                                required><%= review.comment %></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary"
                                            data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary">Save Changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Delete Review Modal -->
                    <div class="modal fade" id="deleteReviewModal-<%= review._id %>" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header bg-danger text-white">
                                    <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Delete
                                        Review</h5>
                                    <button type="button" class="btn-close btn-close-white"
                                        data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <p>Are you sure you want to delete this review? This action cannot be undone.
                                    </p>
                                    <div class="alert alert-warning">
                                        <strong>Rating:</strong>
                                        <%= review.rating %>/5<br>
                                            <strong>Comment:</strong> "<%= review.comment.substring(0, 100) %>
                                                <%= review.comment.length> 100 ? '...' : '' %>"
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary"
                                        data-bs-dismiss="modal">Cancel</button>
                                    <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                        method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-danger">Delete Review</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
            </div>
            <% } else { %>
                <div class="alert alert-info">
                    No reviews yet. Be the first to review this listing!
                </div>
                <% } %>

    </div>

    <!-- Bootstrap Validation -->
    <script>
        (() => {
            'use strict';
            document.querySelectorAll('.needs-validation').forEach(form => {
                form.addEventListener('submit', e => {
                    if (!form.checkValidity()) {
                        e.preventDefault();
                        e.stopPropagation();
                    }
                    form.classList.add('was-validated');
                });
            });
        })();
    </script>