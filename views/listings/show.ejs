<% layout("/layouts/boilerplate") %>

    <div class="container mt-5">
        <div class="card shadow-lg mx-auto show-page-card" style="max-width: 800px;">

            <!-- Image -->
            <img src="<%= listing.image %>" class="card-img-top show-page-image" alt="<%= listing.title %>"
                onerror="this.src='https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800&h=350&fit=crop'">

            <div class="card-body">
                <h3 class="card-title mb-3">
                    <%= listing.title %>
                </h3>

                <p class="card-text text-muted mb-4">
                    <%= listing.description %>
                </p>

                <ul class="list-group list-group-flush my-3 show-page-list">
                    <li class="list-group-item">
                        <strong><i class="fas fa-rupee-sign me-2 text-success"></i>Price:</strong>
                        <span class="float-end fw-bold text-success">
                            ₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / month
                        </span>
                    </li>

                    <li class="list-group-item">
                        <strong><i class="fas fa-map-marker-alt me-2 text-primary"></i>Location:</strong>
                        <span class="float-end">
                            <%= listing.location %>
                        </span>
                    </li>
                    <li class="list-group-item">
                        <strong><i class="fas fa-phone me-2 text-info"></i>Contact:</strong>
                        <span class="float-end">
                            <%= listing.contact %>
                        </span>
                    </li>
                </ul>

                <!-- Action Buttons -->
                <div class="d-flex flex-column flex-md-row gap-2 mt-4">
                    <a href="/listings" class="btn btn-outline-secondary flex-fill">
                        <i class="fas fa-arrow-left me-1"></i> Back to Listings
                    </a>
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning flex-fill">
                        <i class="fas fa-edit me-1"></i> Edit
                    </a>
                    <button type="button" class="btn btn-danger flex-fill" data-bs-toggle="modal"
                        data-bs-target="#deleteModal">
                        <i class="fas fa-trash me-1"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteModalLabel">
                        <i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Are you sure you want to delete <strong>"<%= listing.title %>"</strong>?</p>
                    <p class="text-muted small mb-0 mt-2">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i> Cancel
                    </button>
                    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash me-1"></i> Delete Listing
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>